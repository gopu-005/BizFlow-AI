# BizFlow AI Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# When set, connects to your PostgreSQL instance. If omitted, BizFlow uses local JSON storage in data/bizflow-db.json
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizflow_production

# Razorpay Payment Gateway (Test & Sandbox Mode by default)
RAZORPAY_KEY_ID=rzp_test_bizflow999
RAZORPAY_KEY_SECRET=secret_bizflow_test_key_8841
RAZORPAY_WEBHOOK_SECRET=whsec_bizflow_test_88

# AI / LLM Provider (Optional - Rules-first engine runs with 100% accuracy without API keys)
GEMINI_API_KEY=

# Gmail OAuth Connector (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/gmail/callback

# WhatsApp Business Cloud API (Optional)
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=bizflow_webhook_secret_token
