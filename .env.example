# ==============================================================================
# BIZFLOW AI - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Server
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://biz-flowai.netlify.app

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Strong 32+ character random secrets for cryptographic token signing and session cookies
SESSION_SECRET=c5d8a94e21b83f06d871e4a3b7c89f10a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7
ADMIN_SESSION_SECRET=f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8

# Allowed CORS & CSRF Origins (comma-separated)
ALLOWED_ORIGINS=https://biz-flowai.netlify.app,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PLATFORM ADMINISTRATOR PROVISIONING
# ------------------------------------------------------------------------------
# Used exclusively by the offline provisioning script: `npm run provision:admin`
# Public registration will NEVER create platform_admin accounts.
INITIAL_ADMIN_EMAIL=admin@bizflow.in
INITIAL_ADMIN_PASSWORD=Admin@BizFlow2026!
INITIAL_ADMIN_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# 3. OUTBOUND EMAIL SERVICE (Password Recovery & Email Verification)
# ------------------------------------------------------------------------------
# Option A: Standard SMTP (SendGrid, Mailgun, AWS SES, Postmark, Google Workspace)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
SMTP_FROM="BizFlow AI Security <noreply@bizflow.in>"

# Option B: Resend HTTP API (Alternative to SMTP)
# RESEND_API_KEY=re_1234567890abcdef
# EMAIL_FROM="BizFlow AI <noreply@bizflow.in>"

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# When set, connects to PostgreSQL. If omitted, BizFlow uses persistent storage in data/bizflow-db.json
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizflow_production

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY (Verified Entitlements & ₹299/mo Plan)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 6. EXTERNAL CONNECTORS & AGENTS (Optional)
# ------------------------------------------------------------------------------
# Google Gemini LLM API Key (BizFlow's rule engine operates accurately even without this)
GEMINI_API_KEY=

# Gmail OAuth Connector
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://biz-flowai.netlify.app/api/connectors/gmail/callback

# WhatsApp Business Cloud API
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=bizflow_webhook_secret_token
